# Copiá este archivo a .env y completá las claves.
# openai | anthropic | gemini
LLM_PROVIDER=openai

OPENAI_API_KEY=tu_clave_de_openai
ANTHROPIC_API_KEY=tu_clave_de_anthropic
GOOGLE_API_KEY=tu_clave_de_gemini

# El RAG indexa y consulta con OpenAIEmbeddings (text-embedding-3-small).
# Usa OPENAI_API_KEY. El chat usa la clave del LLM_PROVIDER elegido arriba.
